--KD_RANDOMIZATION_RANGE              = (0.9, 1.1)      # unused (kd DR off)
--VELOCITY_PUSH_INTERVAL_S            = (3.0, 6.0)
--VELOCITY_PUSH_RANGE                 = (-0.3, 0.3)     # ramped in via push curriculum
--IMU_ORIENTATION_RANDOMIZATION_ANGLE = 6.0
